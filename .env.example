# Provide either GOOGLE_SERVICE_ACCOUNT_JSON (the entire service-account JSON) or
# GOOGLE_SERVICE_ACCOUNT_FILE (a path outside the repository to the JSON key).
# Never commit service-account credentials or expose them as VITE_ variables.
GOOGLE_SERVICE_ACCOUNT_FILE="C:/secure/imperio-lux-service-account.json"
# Optional. Share the target spreadsheet with the service account email as Editor.
GOOGLE_SHEETS_ID="1CzufAtWYpkx5dYWjPiqdltMyiuIWeR7G4zTKy3_uxcg"
PORT=3000

# Native apps open the published site by default. Override at build/sync time
# to use a development server reachable from the device (LAN IP on real devices).
CAPACITOR_SERVER_URL="https://imperiolux.vercel.app/"

# Initial setup for the first administrator. Use a unique random secret (32+ chars),
# place it in the server's private .env, then enter it once on the login page.
AUTH_BOOTSTRAP_SECRET="replace-with-a-long-random-secret"
# Optional. If omitted, Vercel derives the signing key from the service-account private key.
AUTH_SESSION_SECRET="replace-with-a-different-random-secret-of-32-chars-or-more"

# Optional SMTP settings for username reminders and password reset codes.
# Use a Gmail App Password or your organization's SMTP credentials; never commit real values.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-account@example.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="Imperio Lux <your-account@example.com>"
